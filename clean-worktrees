#!/usr/bin/env bash
# Remove the git worktrees of the repo you're in — skips ones with uncommitted work, live Claude sessions, or in use.
# Usage: clean-worktrees [options]      (run from anywhere inside the repo or one of its worktrees)
#   -n, --dry-run    show what would be removed, delete nothing
#   -b, --branches   also delete each removed worktree's branch, if it's merged or pushed (nothing is lost)
#   -f, --force      also remove worktrees with uncommitted work (and, with -b, unmerged branches)
#   -y, --yes        skip the confirmation prompt
#   -h, --help       show this help
# Never touched: the main checkout, the worktree you're standing in, worktrees a running process
# is sitting in, live Claude Code sessions, and worktrees locked by hand (git worktree unlock <path>).
# Worktrees whose folder was already deleted are pruned from git's list.
set -euo pipefail

usage() { sed -n '2,11{/^#/{s/^# \{0,1\}//;p}}' "$0"; }

# --- parse args ---
dry_run=0 do_branches=0 force=0 assume_yes=0
while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run)  dry_run=1 ;;
    -b|--branches) do_branches=1 ;;
    -f|--force)    force=1 ;;
    -y|--yes)      assume_yes=1 ;;
    -h|--help)     usage; exit 0 ;;
    -[a-z][a-z]*)  # bundled short flags: -by => -b -y
      bundle="${1#-}"; shift; split=()
      while [ -n "$bundle" ]; do split+=("-${bundle:0:1}"); bundle="${bundle:1}"; done
      set -- "${split[@]}" "$@"; continue ;;
    *) echo "clean-worktrees: unknown option '$1'" >&2; echo "try: clean-worktrees --help" >&2; exit 1 ;;
  esac
  shift
done

if ! git rev-parse --git-dir >/dev/null 2>&1; then
  echo "clean-worktrees: not inside a git repository ($PWD)" >&2
  exit 1
fi

# --- read git's worktree list (first entry is the main checkout) ---
WT_PATH=() WT_HEAD=() WT_BRANCH=() WT_LOCKED=() WT_LOCK=() WT_GONE=()
i=-1
while IFS= read -r line; do
  case "$line" in
    "worktree "*)          i=$((i+1)); WT_PATH[i]="${line#worktree }"; WT_HEAD[i]=""; WT_BRANCH[i]=""
                           WT_LOCKED[i]=0; WT_LOCK[i]=""; WT_GONE[i]=0 ;;
    "HEAD "*)              WT_HEAD[i]="${line#HEAD }" ;;
    "branch refs/heads/"*) WT_BRANCH[i]="${line#branch refs/heads/}" ;;
    locked)                WT_LOCKED[i]=1 ;;
    "locked "*)            WT_LOCKED[i]=1; WT_LOCK[i]="${line#locked }" ;;
    prunable*)             WT_GONE[i]=1 ;;
  esac
done < <(git worktree list --porcelain)

main_wt="${WT_PATH[0]}"
here="$(pwd -P)"
g() { git -C "$main_wt" "$@"; }

# "Merged" means reachable from whatever the main checkout has checked out (usually main).
base_sha="$(g rev-parse -q --verify HEAD 2>/dev/null || true)"
base_name="$(g rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"

if [ "${#WT_PATH[@]}" -le 1 ]; then
  echo "No worktrees to clean in $main_wt (only the main checkout)."
  exit 0
fi

# --- helpers ---
show_path() {  # inside the repo: relative; next to it: ../name; else ~-abbreviated
  case "$1" in
    "$main_wt"/*)            printf '%s' "${1#"$main_wt"/}" ;;
    "${main_wt%/*}"/*/*)     printf '%s' "${1/#$HOME\//\~/}" ;;
    "${main_wt%/*}"/*)       printf '../%s' "${1##*/}" ;;
    *)                       printf '%s' "${1/#$HOME\//\~/}" ;;
  esac
}

# Every process's working directory, as "pid<TAB>cwd" lines (Linux/WSL; empty elsewhere).
PROC_CWDS=""
if [ -d /proc/self ]; then
  PROC_CWDS="$(find /proc/[0-9]*/cwd -maxdepth 0 -printf '%h\t%l\n' 2>/dev/null | sed 's|^/proc/||' || true)"
fi

# Print "pid (command)" of a process whose working directory is inside $1; fail if there is none.
process_in() {
  local pid cwd
  while IFS=$'\t' read -r pid cwd; do
    [ -n "$cwd" ] || continue
    if [[ $cwd == "$1" || $cwd == "$1"/* ]]; then
      printf '%s (%s)' "$pid" "$(ps -o comm= -p "$pid" 2>/dev/null || echo '?')"
      return 0
    fi
  done <<<"$PROC_CWDS"
  return 1
}

# Claude Code locks its worktrees with "claude session <name> (pid N start T)", where T is the
# process start time from /proc/N/stat. Succeed if that session is still running.
claude_session_alive() {
  local pid start stat
  [[ $1 =~ pid\ ([0-9]+)\ start\ ([0-9]+) ]] || return 0  # can't tell: assume it's running
  pid="${BASH_REMATCH[1]}" start="${BASH_REMATCH[2]}"
  if [ ! -d /proc/self ]; then kill -0 "$pid" 2>/dev/null; return; fi
  stat="$(cat "/proc/$pid/stat" 2>/dev/null)" || return 1
  stat="${stat##*) }"            # drop "pid (comm) " — comm may contain spaces
  set -- $stat                   # $1 is field 3, so the start time (field 22) is $20
  [ "${20:-}" = "$start" ]
}

# Set B_SAFE=1 if deleting branch $1 loses no commits (merged, or pushed to its upstream), and B_DESC.
branch_state() {
  local b="$1" up n
  if [ -n "$base_sha" ] && g merge-base --is-ancestor "refs/heads/$b" "$base_sha" 2>/dev/null; then
    B_SAFE=1; B_DESC="merged into $base_name"; return
  fi
  if up="$(g rev-parse -q --symbolic-full-name "$b@{upstream}" 2>/dev/null)" && [ -n "$up" ] &&
     g merge-base --is-ancestor "refs/heads/$b" "$up" 2>/dev/null; then
    up="${up#refs/remotes/}"; B_SAFE=1; B_DESC="pushed to ${up#refs/heads/}"; return
  fi
  n="$(g rev-list --count "refs/heads/$b" ${base_sha:+"^$base_sha"} 2>/dev/null || echo '?')"
  B_SAFE=0; B_DESC="has $n commit(s) not in $base_name"
}

# --- decide what to do with each linked worktree ---
ACT=() SIZE=() SHOW=() BR=() WHY=() UNLOCK=() FORCE=() DEL_BR=()
n_remove=0 n_branches=0 n_dirty_skipped=0 n_branch_hint=0
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  wt="${WT_PATH[k]}" b="${WT_BRANCH[k]}" lock="${WT_LOCK[k]}"
  act="remove" why="" unlock=0 frc=0 del_br=0 notes=()

  SHOW[k]="$(show_path "$wt")"
  BR[k]="${b:-(detached)}"
  if [ "${WT_GONE[k]}" -eq 1 ]; then SIZE[k]="-"; else SIZE[k]="$(du -sh "$wt" 2>/dev/null | cut -f1)"; fi

  if [ "${WT_LOCKED[k]}" -eq 1 ] && [[ $lock == "claude session "* ]]; then
    if claude_session_alive "$lock"; then
      act="skip"; why="live Claude session"
      [[ $lock =~ pid\ ([0-9]+) ]] && why+=" (pid ${BASH_REMATCH[1]})"
    else
      unlock=1; notes+=("stale Claude lock")
    fi
  elif [ "${WT_LOCKED[k]}" -eq 1 ]; then
    act="skip"; why="locked${lock:+ ($lock)} — git worktree unlock it to allow"
  fi

  if [ "$act" = "remove" ] && [ "${WT_GONE[k]}" -eq 1 ]; then
    act="prune"; notes+=("folder already deleted")
  elif [ "$act" = "remove" ] && [[ $here == "$wt" || $here == "$wt"/* ]]; then
    act="skip"; why="you're in it"
  elif [ "$act" = "remove" ] && user="$(process_in "$wt")"; then
    act="skip"; why="in use by pid $user"
  elif [ "$act" = "remove" ]; then
    # Uncommitted changes (incl. untracked files) — or commits only reachable from a detached HEAD.
    if changes="$(git -C "$wt" status --porcelain --ignore-submodules=none 2>/dev/null)"; then
      n_changed="$(grep -c . <<<"$changes" || true)"
      [ "$n_changed" -gt 0 ] && lost="$n_changed uncommitted change(s)" || lost=""
    else
      lost="git status failed"
    fi
    if [ -z "$lost" ] && [ -z "$b" ] && [ -n "${WT_HEAD[k]}" ]; then
      n_orphan="$(g rev-list --count "${WT_HEAD[k]}" --not --branches --remotes --tags 2>/dev/null || echo 0)"
      [ "$n_orphan" -gt 0 ] && lost="$n_orphan commit(s) on detached HEAD, not on any branch"
    fi
    if [ -n "$lost" ] && [ "$force" -eq 1 ]; then
      frc=1; notes+=("$lost — WILL BE LOST")
    elif [ -n "$lost" ]; then
      act="skip"; why="$lost (-f to remove anyway)"; n_dirty_skipped=$((n_dirty_skipped+1))
    else
      notes+=("clean")
    fi
  fi

  # What happens to the branch once the worktree is gone.
  if [ "$act" != "skip" ] && [ -n "$b" ]; then
    branch_state "$b"
    if [ "$do_branches" -eq 0 ]; then
      notes+=("branch $B_DESC")
      [ "$B_SAFE" -eq 1 ] && n_branch_hint=$((n_branch_hint+1))
    elif [ "$B_SAFE" -eq 1 ]; then
      del_br=1; notes+=("delete branch ($B_DESC)")
    elif [ "$force" -eq 1 ]; then
      del_br=1; notes+=("delete branch — $B_DESC WILL BE LOST")
    else
      notes+=("keep branch ($B_DESC; -f to delete)")
    fi
  fi

  if [ "$act" != "skip" ]; then
    n_remove=$((n_remove+1)); n_branches=$((n_branches+del_br))
    why="${notes[0]}"
    for note in "${notes[@]:1}"; do why+=" · $note"; done
  fi
  ACT[k]="$act" WHY[k]="$why" UNLOCK[k]="$unlock" FORCE[k]="$frc" DEL_BR[k]="$del_br"
done

# --- show the plan ---
w_path=4 w_br=6
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  [ "${#SHOW[k]}" -gt "$w_path" ] && w_path="${#SHOW[k]}"
  [ "${#BR[k]}" -gt "$w_br" ] && w_br="${#BR[k]}"
done
echo "Worktrees of $main_wt:"
echo
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  printf '  %-6s %5s  %-*s  %-*s  %s\n' "${ACT[k]}" "${SIZE[k]}" "$w_path" "${SHOW[k]}" "$w_br" "${BR[k]}" "${WHY[k]}"
done
echo
if [ "$n_dirty_skipped" -gt 0 ]; then
  echo "Skipped $n_dirty_skipped with uncommitted work — commit it, or rerun with -f to throw it away."
fi
if [ "$n_branch_hint" -gt 0 ]; then
  echo "Add -b to also delete the $n_branch_hint merged/pushed branch(es) (nothing is lost)."
fi

if [ "$n_remove" -eq 0 ]; then
  echo "Nothing to clean."
  exit 0
fi
if [ "$dry_run" -eq 1 ]; then
  echo "Dry run — nothing was removed."
  exit 0
fi

# --- confirm ---
if [ "$assume_yes" -eq 0 ]; then
  prompt="Remove $n_remove worktree(s)"
  [ "$n_branches" -gt 0 ] && prompt+=" and delete $n_branches branch(es)"
  printf '%s? [y/N] ' "$prompt"
  read -r ans || ans=""
  case "$ans" in
    y|Y|yes|YES) ;;
    *) echo "Aborted."; exit 1 ;;
  esac
fi

# --- remove ---
failed=0
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  [ "${ACT[k]}" = "skip" ] && continue
  wt="${WT_PATH[k]}"
  [ "${UNLOCK[k]}" -eq 1 ] && g worktree unlock "$wt"
  if [ "${ACT[k]}" = "prune" ]; then continue; fi
  if [ "${FORCE[k]}" -eq 1 ]; then rm_args=(--force); else rm_args=(); fi
  if g worktree remove ${rm_args[@]+"${rm_args[@]}"} "$wt"; then
    echo "Removed ${SHOW[k]}"
  else
    echo "Could not remove ${SHOW[k]} (see git's message above)" >&2
    DEL_BR[k]=0; failed=1
  fi
done
g worktree prune
still_listed="$(g worktree list --porcelain)"
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  [ "${ACT[k]}" = "prune" ] || continue
  if grep -qxF "worktree ${WT_PATH[k]}" <<<"$still_listed"; then
    echo "Could not prune ${SHOW[k]}" >&2; DEL_BR[k]=0; failed=1
  else
    echo "Pruned ${SHOW[k]} (folder was already gone)"
  fi
done
for ((k=1; k<${#WT_PATH[@]}; k++)); do
  [ "${DEL_BR[k]}" -eq 1 ] || continue
  if g branch -D -q "${WT_BRANCH[k]}"; then
    echo "Deleted branch ${WT_BRANCH[k]}"
  else
    failed=1
  fi
done

[ "$failed" -eq 0 ] && echo "Done." || { echo "Done, with errors." >&2; exit 1; }
