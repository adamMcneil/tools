#!/usr/bin/env bash
# Move (or copy, with -c) files/folders from WSL to the Windows Desktop.
# Usage: mtw [-c|--copy] <file>...   e.g.  mtw report.pdf *.csv
#        -c, --copy   copy instead of move, so the originals stay in WSL
# Asks before overwriting anything already on the Desktop.
usage() { echo "usage: mtw [-c|--copy] <file>..." >&2; }

copy=false
files=()
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--copy) copy=true ;;
    -h|--help) usage; exit 0 ;;
    --) shift; files+=("$@"); break ;;
    -*) echo "mtw: unknown option: $1" >&2; usage; exit 1 ;;
    *) files+=("$1") ;;
  esac
  shift
done

if [ ${#files[@]} -eq 0 ]; then
  usage
  exit 1
fi

# Ask Windows where the Desktop is (handles OneDrive-redirected Desktops).
win_desktop="$(powershell.exe -NoProfile -Command "[Environment]::GetFolderPath('Desktop')" 2>/dev/null | tr -d '\r')"
if [ -z "$win_desktop" ]; then
  echo "mtw: could not find the Windows Desktop" >&2
  exit 1
fi
desktop="$(wslpath -u "$win_desktop")"

if $copy; then
  cp -riv --preserve=timestamps -- "${files[@]}" "$desktop"/
else
  mv -iv -- "${files[@]}" "$desktop"/
fi
